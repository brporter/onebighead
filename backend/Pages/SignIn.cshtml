@page
@model SignInModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="landing">
    <header class="landing__header">
        <div class="landing__header-content">
            <a asp-page="/Index" class="landing__logo">OneBigHead</a>
            <nav class="landing__nav">
                <a asp-page="/About" class="landing__nav-link">About</a>
                <a asp-page="/Terms" class="landing__nav-link">Terms of Service</a>
                <a asp-page="/Privacy" class="landing__nav-link">Privacy Policy</a>
            </nav>
        </div>
    </header>

    <main class="landing__main landing__main--centered">
        <div class="landing__form-container">
            <h1>Welcome Back</h1>
            <p class="landing__form-subtitle">
                Sign in to access your collections.
            </p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="landing__alert landing__alert--error">
                    @Model.ErrorMessage
                </div>
            }

            <div class="landing__sso-buttons">
                <button type="button" class="landing__sso-button landing__sso-button--microsoft" 
                        onclick="signInWithProvider('Microsoft')" 
                        disabled="@(!Model.MicrosoftEnabled)">
                    <svg class="landing__sso-icon" viewBox="0 0 21 21" xmlns="http://www.w3.org/2000/svg">
                        <rect x="1" y="1" width="9" height="9" fill="#f25022"/>
                        <rect x="11" y="1" width="9" height="9" fill="#7fba00"/>
                        <rect x="1" y="11" width="9" height="9" fill="#00a4ef"/>
                        <rect x="11" y="11" width="9" height="9" fill="#ffb900"/>
                    </svg>
                    <span>Continue with Microsoft</span>
                </button>

                <button type="button" class="landing__sso-button landing__sso-button--google"
                        onclick="signInWithProvider('Google')"
                        disabled="@(!Model.GoogleEnabled)">
                    <svg class="landing__sso-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                    </svg>
                    <span>Continue with Google</span>
                </button>

                <button type="button" class="landing__sso-button landing__sso-button--apple"
                        onclick="signInWithProvider('Apple')"
                        disabled="@(!Model.AppleEnabled)">
                    <svg class="landing__sso-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M17.05 20.28c-.98.95-2.05.88-3.08.4-1.09-.5-2.08-.48-3.24 0-1.44.62-2.2.44-3.06-.4C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" fill="currentColor"/>
                    </svg>
                    <span>Continue with Apple</span>
                </button>
            </div>

            <div class="landing__sso-divider">
                <span>Secure authentication</span>
            </div>

            <p class="landing__sso-info">
                We use secure federated authentication through trusted identity providers.
                Your password is never stored on our servers.
            </p>
        </div>
    </main>

    <footer class="landing__footer">
        <div class="landing__footer-content">
            <p>&copy; 2026 OneBigHead. All rights reserved.</p>
            <nav class="landing__footer-nav">
                <a asp-page="/About">About</a>
                <a asp-page="/Terms">Terms of Service</a>
                <a asp-page="/Privacy">Privacy Policy</a>
            </nav>
        </div>
    </footer>
</div>

@section Scripts {
<script>
    function signInWithProvider(provider) {
        const button = event.target.closest('button');
        if (button.disabled) {
            return;
        }
        
        // Get return URL from the page model (passed via query string)
        const returnUrl = '@Html.Raw(Model.ReturnUrl ?? "/collections")';
        
        // Redirect to the OAuth initiation endpoint with return URL
        const loginUrl = `/api/auth/login/${provider.toLowerCase()}?returnUrl=${encodeURIComponent(returnUrl)}`;
        window.location.href = loginUrl;
    }
</script>
}

