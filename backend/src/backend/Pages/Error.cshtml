@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="landing">
    <header class="landing__header">
        <div class="landing__header-content">
            <a asp-page="/Index" class="landing__logo">OneBigHead</a>
        </div>
    </header>
    <main class="landing__main landing__main--centered">
        <section class="landing__form-container" aria-labelledby="error-title">
            <h1 id="error-title">Something went wrong</h1>
            <p>We couldn't complete your request. Please try again.</p>
            @if (Model.ShowRequestId)
            {
                <p>If you contact support, include this reference:</p>
                <p><code class="landing__reference">@Model.RequestId</code></p>
            }
            <div class="landing__cta">
                <a asp-page="/Index" class="landing__button landing__button--primary">Return home</a>
                <a href="/settings?section=support" class="landing__button landing__button--secondary">Contact support</a>
            </div>
        </section>
    </main>
</div>
