{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Authentication": {
    "Jwt": {
      "SigningKey": "REPLACE_WITH_SECURE_KEY_AT_LEAST_32_CHARACTERS_LONG",
      "Issuer": "onebighead",
      "Audience": "onebighead-app",
      "SlidingExpirationMinutes": 1440,
      "AbsoluteExpirationDays": 7
    },
    "Cookie": {
      "Name": "auth_token",
      "Secure": true,
      "SameSite": "Strict"
    },
    "OAuth": {
      "BaseUrl": "https://onebighead.com",
      "CallbackPath": "/api/auth/callback",
      "PostLoginRedirectUrl": "/collections",
      "PostLoginErrorUrl": "/signin"
    },
    "Providers": {
      "Microsoft": {
        "Authority": "https://login.microsoftonline.com/common/v2.0",
        "ClientId": "YOUR_MICROSOFT_CLIENT_ID",
        "ClientSecret": "YOUR_MICROSOFT_CLIENT_SECRET",
        "Enabled": true
      },
      "Google": {
        "Authority": "https://accounts.google.com",
        "ClientId": "YOUR_GOOGLE_CLIENT_ID",
        "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET",
        "Enabled": false
      },
      "Apple": {
        "Authority": "https://appleid.apple.com",
        "ClientId": "YOUR_APPLE_CLIENT_ID",
        "ClientSecret": "YOUR_APPLE_CLIENT_SECRET",
        "Enabled": false
      }
    }
  },
  "Email": {
    "ConnectionString": "",
    "SenderAddress": "noreply@onebighead.com",
    "SenderName": "OneBigHead Support",
    "AppBaseUrl": "https://onebighead.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
