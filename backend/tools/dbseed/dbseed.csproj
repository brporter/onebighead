<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- RuntimeIdentifier set at publish time for cross-platform support -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
  </ItemGroup>

  <!-- Link shared seeding code from backend -->
  <ItemGroup>
    <Compile Include="..\..\src\backend\Services\Seeding\SeedModels.cs" Link="Seeding\SeedModels.cs" />
    <Compile Include="..\..\src\backend\Services\Seeding\JsonDatabaseSeeder.cs" Link="Seeding\JsonDatabaseSeeder.cs" />
  </ItemGroup>

</Project>
