<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- RuntimeIdentifier set at publish time for cross-platform support -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
  </ItemGroup>

  <!-- Link shared seeding code from backend -->
  <ItemGroup>
    <Compile Include="..\..\src\backend\Services\Seeding\JsonValueConverter.cs">
      <Link>Seeding\JsonValueConverter.cs</Link>
    </Compile>
    <Compile Include="..\..\src\backend\Services\Seeding\SeedFile.cs">
      <Link>Seeding\SeedFile.cs</Link>
    </Compile>
    <Compile Include="..\..\src\backend\Services\Seeding\JsonDatabaseSeeder.cs" Link="Seeding\JsonDatabaseSeeder.cs" />
    <Compile Include="..\..\src\backend\Services\Seeding\SeedResult.cs">
      <Link>Seeding\SeedResult.cs</Link>
    </Compile>
    <Compile Include="..\..\src\backend\Services\Seeding\SeedTable.cs">
      <Link>Seeding\SeedTable.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
