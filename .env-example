# Database Configuration
# Use ConnectionStrings__DefaultConnection for ASP.NET Core configuration binding
ConnectionStrings__DefaultConnection=Server=localhost;Database=onebighead;User Id=myuser;Password=mypassword;

# JWT Configuration
Authentication__Jwt__SigningKey=your-jwt-signing-key-at-least-32-characters-long

# OAuth Base URL (your application's public URL)
Authentication__OAuth__BaseUrl=https://your-domain.com

# Microsoft OAuth Provider
Authentication__Providers__Microsoft__ClientId=your-microsoft-client-id
Authentication__Providers__Microsoft__ClientSecret=your-microsoft-client-secret
Authentication__Providers__Microsoft__Enabled=true

# Google OAuth Provider
Authentication__Providers__Google__ClientId=your-google-client-id
Authentication__Providers__Google__ClientSecret=your-google-client-secret
Authentication__Providers__Google__Enabled=false

# Apple OAuth Provider
Authentication__Providers__Apple__ClientId=your-apple-service-id
Authentication__Providers__Apple__ClientSecret=your-apple-client-secret
Authentication__Providers__Apple__Enabled=false

# GitHub MCP
GITHUB_PAT=your_pat
