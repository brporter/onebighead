# Copy to .env on the VM (/opt/onebighead/.env) and fill in real values.
# The .env file holds production secrets — never commit it.

# --- Database (PostgreSQL container on the VM) ---
# The postgres service in docker-compose.yml reads POSTGRES_PASSWORD from this
# file (compose interpolation); the app connects over the compose-internal
# network using the same credentials.
POSTGRES_PASSWORD=<strong-database-password>
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=onebighead;Username=onebighead;Password=<strong-database-password>

# --- Authentication ---
Authentication__Jwt__SigningKey=<min-32-char-signing-key>
Authentication__OAuth__BaseUrl=https://onebighead.com

Authentication__Providers__Microsoft__Enabled=true
Authentication__Providers__Microsoft__ClientId=<microsoft-client-id>
Authentication__Providers__Microsoft__ClientSecret=<microsoft-client-secret>

Authentication__Providers__Google__Enabled=true
Authentication__Providers__Google__ClientId=<google-client-id>
Authentication__Providers__Google__ClientSecret=<google-client-secret>

Authentication__Providers__Apple__Enabled=true
Authentication__Providers__Apple__ClientId=<apple-client-id>
Authentication__Providers__Apple__ClientSecret=<apple-client-secret>

# --- Email (Azure Communication Services) ---
Email__ConnectionString=<acs-connection-string>
Email__SenderAddress=noreply@onebighead.com
Email__AppBaseUrl=https://onebighead.com

# --- Telemetry (optional) ---
APPLICATIONINSIGHTS_CONNECTION_STRING=<app-insights-connection-string>
