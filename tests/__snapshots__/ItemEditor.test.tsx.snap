        >
          Name
        </label>
        <input
          class="detail__input"
          id="item-name"
          placeholder="Item name"
          required=""
          type="text"
          value=""
        />
      </div>
      <div
        class="detail__field"
      >
        <label
          class="detail__label"
          for="item-summary"
        >
          Summary
        </label>
        <input
          class="detail__input"
          id="item-summary"
          placeholder="Brief summary"
          type="text"
          value=""
        />
      </div>
      <div
        class="detail__field"
      >
        <label
          class="detail__label"
          for="item-description"
        >
          Description
        </label>
        <textarea
          class="detail__textarea"
          id="item-description"
          placeholder="Full description"
          rows="4"
        />
