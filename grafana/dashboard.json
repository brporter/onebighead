          "azureMonitor": {
            "appInsights": {
              "query": "requests\n| where timestamp >= $__timeFrom and timestamp <= $__timeTo\n| summarize\n    succeeded = countif(success == true),\n    failed = countif(success == false)\n    by bin(timestamp, $__interval)\n| order by timestamp asc",
