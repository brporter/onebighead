      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Success Rate",
      "type": "stat",
      "targets": [
        {
          "azureMonitor": {
            "appInsights": {
              "query": "requests\n| where timestamp >= $__timeFrom and timestamp <= $__timeTo\n| summarize success_rate = round(100.0 * countif(success == true) / count(), 2)\n| project success_rate",
              "timeColumn": ""
            },
            "queryType": "Azure Log Analytics",
            "resource": "$resource"
          },
          "refId": "A"
        }
      ]
    },
