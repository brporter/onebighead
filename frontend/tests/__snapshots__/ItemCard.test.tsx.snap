    class="item-card item-card--textonly"
    role="button"
    tabindex="0"
  >
    <div
      class="item-card__ribbon"
      style="background: linear-gradient(90deg, rgb(199, 125, 74), rgb(212, 165, 116));"
    />
    <div
      class="item-card__body"
    >
      <div
        class="item-card__name"
