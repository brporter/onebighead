// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CollectionTemplateEditor > snapshots > should match snapshot with templates loaded 1`] = `
<div>
  <section
    class="template-assignment"
  >
    <h3
      class="template-assignment__title"
    >
      Templates for "
      Test Collection
      "
    </h3>
    <p
      class="template-assignment__description"
    >
      Select which templates should be available when creating new items in this collection. Templates not selected here can still be used from the full template library.
    </p>
    <fieldset
      aria-label="Collection templates"
      class="template-checklist"
    >
      <label
        class="template-checklist__option"
      >
        <input
          aria-label="Template A"
          checked=""
          type="checkbox"
        />
        <span
          class="template-checklist__content"
        >
          <span
            class="template-checklist__name"
          >
            Template A
          </span>
          <span
            class="template-checklist__description"
          >
            First template
          </span>
          <span
            class="template-checklist__count"
          >
            1 property
          </span>
        </span>
      </label>
      <label
        class="template-checklist__option"
      >
        <input
          aria-label="Template B"
          type="checkbox"
        />
        <span
          class="template-checklist__content"
        >
          <span
            class="template-checklist__name"
          >
            Template B
          </span>
          <span
            class="template-checklist__badge"
          >
            System
          </span>
          <span
            class="template-checklist__description"
          >
            Second template
          </span>
          <span
            class="template-checklist__count"
          >
            0 properties
          </span>
        </span>
      </label>
      <label
        class="template-checklist__option"
      >
        <input
          aria-label="Template C"
          type="checkbox"
        />
        <span
          class="template-checklist__content"
        >
          <span
            class="template-checklist__name"
          >
            Template C
          </span>
          <span
            class="template-checklist__count"
          >
            2 properties
          </span>
        </span>
      </label>
    </fieldset>
    <div
      aria-busy="false"
      class="template-assignment__actions"
    >
      <button
        class="detail__btn detail__btn--primary"
        disabled=""
        type="button"
      >
        Save Changes
      </button>
      <button
        class="detail__btn detail__btn--secondary"
        type="button"
      >
        Back
      </button>
    </div>
  </section>
</div>
