// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`PropertyEditor > snapshots > should render with empty properties 1`] = `
<div>
  <div
    class="propertyEditor"
  >
    <label
      class="propertyEditor__label"
    >
      Properties
    </label>
    <div
      class="propertyEditor__empty"
    >
      <p>
        No properties yet. Add properties to describe your item.
      </p>
    </div>
    <button
      class="propertyEditor__add"
      type="button"
    >
      + Add Property
    </button>
    <datalist
      id="property-category-suggestions"
    >
      <option
        value="General"
      />
      <option
        value="Technical"
      />
    </datalist>
    <datalist
      id="property-name-suggestions"
    >
      <option
        value="Color"
      />
      <option
        value="Size"
      />
    </datalist>
  </div>
</div>
`;

