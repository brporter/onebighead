              />
              <input
                class="propertyEditor__input propertyEditor__input--value"
                placeholder="Value"
                type="text"
                value="Value3"
              />
              <button
                aria-label="Remove property"
                class="propertyEditor__remove"
                type="button"
              >
                ×
              </button>
            </div>
          </div>
        </div>
        <div
          id="DndDescribedBy-0"
          style="display: none;"
        >
          
    To pick up a draggable item, press the space bar.
    While dragging, use the arrow keys to move the item.
    Press space again to drop the item in its new position, or press escape to cancel.
  
        </div>
        <div
          aria-atomic="true"
          aria-live="assertive"
          id="DndLiveRegion-0"
          role="status"
          style="position: fixed; top: 0px; left: 0px; width: 1px; height: 1px; margin: -1px; border: 0px; padding: 0px; overflow: hidden; clip: rect(0px); clip-path: inset(100%); white-space: nowrap;"
        />
        <button
          class="propertyEditor__add"
          type="button"
        >
          + Add Property
        </button>
        <datalist
          id="property-category-suggestions"
        />
        <datalist
          id="property-name-suggestions"
        />
      </div>
      <div
        class="imageEditor"
      >
        <label
          class="imageEditor__label"
        >
          Images
        </label>
        <div
          class="imageEditor__grid"
        >
          <div
            class="imageEditor__item"
          >
            <div
              class="imageEditor__preview"
            >
              <img
                alt="Image 1"
                class="imageEditor__image"
                src="https://example.com/image1.jpg"
              />
              <button
                aria-label="Remove image"
                class="imageEditor__remove"
                type="button"
              >
                ×
              </button>
            </div>
            <input
              class="imageEditor__input imageEditor__input--alt"
              placeholder="Alt text"
              type="text"
              value="Image 1"
            />
          </div>
          <div
            class="imageEditor__item"
          >
            <div
              class="imageEditor__preview"
            >
              <img
                alt="Image 2"
                class="imageEditor__image"
                src="https://example.com/image2.jpg"
              />
              <button
                aria-label="Remove image"
                class="imageEditor__remove"
                type="button"
              >
                ×
              </button>
            </div>
            <input
              class="imageEditor__input imageEditor__input--alt"
              placeholder="Alt text"
              type="text"
              value="Image 2"
            />
          </div>
        </div>
        <input
          accept="image/jpeg,image/png,image/gif,image/webp"
          class="imageEditor__fileInput"
          multiple=""
          type="file"
        />
        <button
          class="imageEditor__add"
          type="button"
        >
          + Add Image
        </button>
      </div>
      <div
        class="detail__field"
      >
        <div
          class="visibility-toggle"
        >
          <label
            class="visibility-label"
          >
            Visibility
          </label>
          <div
            class="visibility-options"
          >
            <button
              class="visibility-option selected"
              title="Inherit from parent (Private)"
              type="button"
            >
              Inherit (
              Private
              )
            </button>
            <button
              class="visibility-option "
              disabled=""
              title="Mark as public"
              type="button"
            >
              Public
            </button>
            <button
              class="visibility-option "
              title="Mark as private"
              type="button"
            >
              Private
            </button>
          </div>
          <div
            class="visibility-note"
          >
            Parent is private; cannot override to public
          </div>
          <div
            class="visibility-effective"
          >
            Effective: 
            <span
              class="public"
            >
              Public
            </span>
          </div>
        </div>
      </div>
      <fieldset
        class="detail__fieldset"
      >
        <legend
          class="detail__legend"
        >
          My Relationship to This Item
        </legend>
        <div
          class="detail__radioGroup"
        >
          <label
            class="detail__radioLabel"
          >
            <input
              checked=""
              class="detail__radioInput"
              name="userFlag"
              type="radio"
            />
            <span
              class="detail__radioText"
            >
              None
            </span>
          </label>
          <label
            class="detail__radioLabel"
          >
            <input
              class="detail__radioInput"
              name="userFlag"
              type="radio"
            />
            <span
              class="detail__radioText"
            >
              I Have This
            </span>
          </label>
          <label
            class="detail__radioLabel"
          >
            <input
              class="detail__radioInput"
              name="userFlag"
              type="radio"
            />
            <span
              class="detail__radioText"
            >
              I Want This
            </span>
          </label>
          <label
            class="detail__radioLabel"
          >
            <input
              class="detail__radioInput"
              name="userFlag"
              type="radio"
            />
            <span
              class="detail__radioText"
            >
              For Trade/Sale
            </span>
          </label>
        </div>
      </fieldset>
      <div
        class="detail__actions"
      >
        <button
          class="detail__btn detail__btn--primary"
          type="button"
        >
          Save Changes
        </button>
        <button
          class="detail__btn detail__btn--secondary"
          type="button"
        >
          Cancel
        </button>
      </div>
    </form>
  </section>
</div>
`;

