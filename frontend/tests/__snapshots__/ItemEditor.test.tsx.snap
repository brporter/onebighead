              name="userFlag"
              type="radio"
            />
            <span
              class="detail__radioText"
            >
              I Have This
            </span>
          </label>
          <label
            class="detail__radioLabel"
          >
            <input
              class="detail__radioInput"
              name="userFlag"
              type="radio"
            />
            <span
              class="detail__radioText"
            >
              I Want This
            </span>
          </label>
          <label
            class="detail__radioLabel"
          >
            <input
              class="detail__radioInput"
              name="userFlag"
              type="radio"
            />
            <span
              class="detail__radioText"
            >
              For Trade/Sale
            </span>
          </label>
        </div>
      </fieldset>
      <div
        class="detail__actions"
      >
        <button
          class="detail__btn detail__btn--primary"
          type="button"
        >
          Save Changes
        </button>
        <button
          class="detail__btn detail__btn--secondary"
          type="button"
        >
          Cancel
        </button>
      </div>
    </form>
  </section>
</div>
`;

