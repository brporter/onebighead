exports[`ItemEditor > snapshots > should render edit mode 1`] = `
<div>
  <section
    class="detail detail--editing"
  >
    <form
      class="detail__form"
    >
      <div
        class="detail__header"
      >
        <h2
          class="detail__title"
        >
          Edit: Test Item
        </h2>
      </div>
      <div
        class="detail__field"
      >
        <label
          class="detail__label"
          for="item-name"
        >
          Name
        </label>
        <input
          autocomplete="off"
          class="detail__input"
          id="item-name"
          placeholder="Item name"
          required=""
          type="text"
          value="Test Item"
        />
      </div>
      <div
        class="detail__field"
      >
        <label
          class="detail__label"
          for="item-summary"
        >
          Summary
        </label>
        <input
          class="detail__input"
          id="item-summary"
          placeholder="Brief summary"
          type="text"
          value="Test summary"
        />
      </div>
      <div
        class="detail__field"
      >
        <label
          class="detail__label"
          for="item-description"
        >
          Description
        </label>
        <textarea
          class="detail__textarea"
          id="item-description"
          placeholder="Full description"
          rows="4"
        >
          Test description
        </textarea>
      </div>
      <div
        class="detail__field"
      >
        <label
          class="detail__label"
          for="category-selector"
        >
          Category
        </label>
        <select
          class="detail__input"
          id="category-selector"
        >
          <option
            value=""
          >
            No category
          </option>
          <option
            value="1"
          >
            Category 1
          </option>
          <option
            value="2"
          >
            Category 2
          </option>
        </select>
      </div>
      <div
        class="propertyEditor"
      >
        <label
          class="propertyEditor__label"
        >
          Properties
        </label>
        <div
          class="propertyEditor__list"
        >
          <div
            class="propertyEditor__categoryGroup"
          >
            <div
              class="propertyEditor__categoryHeader"
            >
              General
            </div>
            <div
              class="propertyEditor__row "
            >
              <div
                aria-describedby="DndDescribedBy-0"
                aria-disabled="false"
                aria-roledescription="sortable"
                class="drag-handle"
                role="button"
                tabindex="0"
              >
                <svg
                  aria-hidden="true"
                  fill="currentColor"
                  height="16"
                  viewBox="0 0 16 16"
                  width="16"
                >
                  <circle
                    cx="5"
                    cy="3"
                    r="1.5"
                  />
                  <circle
                    cx="11"
                    cy="3"
                    r="1.5"
                  />
                  <circle
                    cx="5"
                    cy="8"
                    r="1.5"
                  />
                  <circle
                    cx="11"
                    cy="8"
                    r="1.5"
                  />
                  <circle
                    cx="5"
                    cy="13"
                    r="1.5"
                  />
                  <circle
                    cx="11"
                    cy="13"
                    r="1.5"
                  />
                </svg>
              </div>
              <input
                class="propertyEditor__input propertyEditor__input--category"
                list="property-category-suggestions"
                placeholder="Category"
                type="text"
                value="General"
              />
              <input
                class="propertyEditor__input propertyEditor__input--name"
                list="property-name-suggestions"
                placeholder="Name"
                type="text"
                value="Prop1"
              />
              <input
