        />
        <button
          class="imageEditor__add"
          type="button"
        >
          + Add Image
        </button>
      </div>
      <div
        class="detail__actions"
      >
        <button
          class="detail__btn detail__btn--primary"
          disabled=""
          type="button"
        >
          Create Item
        </button>
        <button
          class="detail__btn detail__btn--secondary"
          type="button"
        >
          Cancel
        </button>
      </div>
    </form>
  </section>
</div>
`;
