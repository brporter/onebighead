        >
          Invite
        </button>
      </div>
    </form>
    <div
      class="userManagement__list"
    >
      <div
        class="userManagement__user userManagement__user--pending"
      >
        <div
          class="userManagement__userInfo"
        >
          <div
            class="userManagement__userEmail"
          >
            pending@example.com
          </div>
          <div
            class="userManagement__userMeta"
          >
            <span
              class="userManagement__statusBadge userManagement__statusBadge--pending"
            >
              Pending
            </span>
          </div>
        </div>
        <div
          class="userManagement__userActions"
        >
          <select
            class="userManagement__roleSelect"
          >
            <option
              value="Normal"
            >
              Member
            </option>
            <option
              value="TenantAdmin"
            >
              Admin
            </option>
          </select>
          <button
            class="userManagement__removeButton"
            title="Remove user"
          >
            Remove
          </button>
        </div>
      </div>
    </div>
    <div
      class="userManagement__legend"
    >
      <p>
        <strong>
          Admin:
