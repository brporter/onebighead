// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`WorkspaceEditModal > snapshots > should match snapshot when open 1`] = `
<div>
  <dialog
    aria-label="Edit Workspace"
    class="modal-dialog "
    open=""
  >
    <div
      class="modal workspace-edit-modal"
    >
      <div
        class="modal__header"
      >
        <h2
          class="modal__title"
        >
          Edit Workspace
        </h2>
        <button
          aria-label="Close"
          class="modal__close"
          type="button"
        >
          ×
        </button>
      </div>
      <form
        aria-label="Edit workspace details"
        class="modal__body"
      >
        <fieldset
          class="workspace-edit-modal__fields"
        >
          <div
            class="modal__field"
          >
            <label
              class="modal__label"
              for="_r_l_-name"
            >
              Workspace Name
              <span
                aria-hidden="true"
                class="modal__required"
              >
                 *
              </span>
            </label>
            <input
              class="modal__input"
              id="_r_l_-name"
              maxlength="200"
              placeholder="Workspace name"
              required=""
              type="text"
              value="Test Workspace"
            />
          </div>
          <h3
            class="workspace-edit-modal__section-title"
          >
            Public Gallery
          </h3>
          <div
            class="modal__field"
          >
            <label
              class="modal__label"
              for="_r_l_-slug"
            >
              Gallery URL Slug
            </label>
            <input
              aria-describedby="_r_l_-hint"
              class="modal__input"
              id="_r_l_-slug"
              maxlength="50"
              placeholder="my-workspace"
              type="text"
              value="test-workspace"
            />
            <p
              class="workspace-edit-modal__hint"
              id="_r_l_-hint"
            >
              Reserve your gallery URL. Your gallery becomes active when you publish your first item.
            </p>
          </div>
          <div
            class="workspace-edit-modal__preview"
          >
            <span
              class="workspace-edit-modal__preview-label"
            >
              Gallery URL:
            </span>
            <code
              class="workspace-edit-modal__preview-url"
            >
              /public/
              test-workspace
            </code>
          </div>
          <div
            class="modal__actions"
          >
            <button
              class="modal__button modal__button--primary"
              type="submit"
            >
              Save
            </button>
            <button
              class="modal__button modal__button--secondary"
              type="button"
            >
              Cancel
            </button>
          </div>
        </fieldset>
      </form>
    </div>
  </dialog>
</div>
`;

exports[`WorkspaceEditModal > snapshots > should match snapshot with error 1`] = `
