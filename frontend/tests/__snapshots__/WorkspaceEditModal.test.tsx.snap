exports[`WorkspaceEditModal > snapshots > should match snapshot with public access enabled 1`] = `
<div>
  <dialog
    class="modal-dialog"
    open=""
  >
    <div
      class="modal"
    >
      <div
        class="modal__header"
      >
        <h2
          class="modal__title"
        >
          Edit Workspace
        </h2>
        <button
          aria-label="Close"
          class="modal__close"
          type="button"
        >
          ×
        </button>
      </div>
      <form
        class="modal__body"
      >
        <div
          class="modal__field"
        >
          <label
            class="modal__label"
            for="workspace-name"
          >
            Workspace Name 
            <span
              class="modal__required"
            >
              *
            </span>
          </label>
          <input
            class="modal__input"
            id="workspace-name"
            maxlength="200"
            placeholder="Workspace name"
            required=""
            type="text"
            value="Test Workspace"
          />
        </div>
        <div
          class="modal__divider"
        />
        <h3
          class="modal__section-title"
        >
          Public Access
        </h3>
        <div
          class="modal__field"
        >
          <label
            class="modal__label"
            for="public-slug"
          >
            Public URL Slug
          </label>
          <input
            class="modal__input"
            id="public-slug"
            maxlength="50"
            placeholder="my-workspace"
            type="text"
            value="my-workspace"
          />
          <p
            class="modal__hint"
          >
            Lowercase letters, numbers, and hyphens only. 3-50 characters.
          </p>
        </div>
        <div
          class="modal__field"
        >
          <label
            class="workspace-edit-modal__toggle-label"
          >
            <input
              checked=""
              type="checkbox"
            />
            <span>
              Enable Public Access
            </span>
          </label>
        </div>
        <div
          class="workspace-edit-modal__preview"
        >
          <span
            class="workspace-edit-modal__preview-label"
          >
            Public URL:
          </span>
          <code
            class="workspace-edit-modal__preview-url"
          >
            /public/
            my-workspace
          </code>
        </div>
        <div
          class="modal__actions"
        >
          <button
            class="detail__btn detail__btn--primary"
            type="submit"
          >
            Save
          </button>
          <button
            class="detail__btn detail__btn--secondary"
            type="button"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </dialog>
</div>
`;
