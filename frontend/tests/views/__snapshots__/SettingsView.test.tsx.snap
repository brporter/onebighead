exports[`SettingsView > snapshots > should match snapshot for admin user - collections section 1`] = `
<div>
  <div
    class="app"
  >
    <header
      data-testid="site-header"
    >
      <span>
        Site Header
      </span>
      <a
        class="gallery-link"
        href="/collections"
      >
        Return to Collections
      </a>
      <button
        aria-label="Support"
        class="support-link support-link--icon"
        title="Support"
      >
        <span
          class="support-link__icon"
        >
          ?
        </span>
      </button>
      <button
        data-testid="user-button"
      >
        User Button
      </button>
    </header>
    <div
      class="app__layout"
    >
      <nav
        aria-label="Settings navigation"
        class="app__sidebar"
      >
        <div
          class="settings-nav"
        >
          <ul
            class="settings-nav__list"
          >
            <li>
              <button
                class="settings-nav__item "
              >
                <span
                  class="settings-nav__icon"
                >
                  📊
                </span>
                <span
                  class="settings-nav__label"
                >
                  Dashboard
                </span>
              </button>
            </li>
            <li>
              <button
                class="settings-nav__item settings-nav__item--active"
              >
                <span
                  class="settings-nav__icon"
                >
                  📚
                </span>
                <span
                  class="settings-nav__label"
                >
                  Collections
                </span>
              </button>
            </li>
            <li>
              <button
                class="settings-nav__item "
              >
                <span
                  class="settings-nav__icon"
                >
                  📋
                </span>
                <span
                  class="settings-nav__label"
                >
                  Item Templates
                </span>
              </button>
            </li>
            <li>
              <button
                class="settings-nav__item "
              >
                <span
                  class="settings-nav__icon"
                >
                  👥
                </span>
                <span
                  class="settings-nav__label"
                >
                  Team Members
                </span>
              </button>
            </li>
            <li>
              <button
                class="settings-nav__item "
              >
                <span
                  class="settings-nav__icon"
                >
                  📦
                </span>
                <span
                  class="settings-nav__label"
                >
                  Data Export
                </span>
              </button>
            </li>
            <li>
              <button
                class="settings-nav__item "
              >
                <span
                  class="settings-nav__icon"
                >
                  🏢
                </span>
                <span
                  class="settings-nav__label"
                >
                  My Workspaces
                </span>
              </button>
            </li>
            <li>
              <button
                class="settings-nav__item "
              >
                <span
                  class="settings-nav__icon"
                >
                  💬
                </span>
                <span
                  class="settings-nav__label"
                >
                  Support
                </span>
              </button>
            </li>
            <li>
              <button
                class="settings-nav__item "
              >
                <span
                  class="settings-nav__icon"
                >
                  👤
                </span>
                <span
                  class="settings-nav__label"
                >
                  Account
                </span>
              </button>
            </li>
          </ul>
        </div>
      </nav>
      <main
        class="app__content settings-content"
      >
        <div
          class="settings-title-bar"
        >
          <h1
            class="settings-title-bar__title"
          >
            Settings
          </h1>
        </div>
        <div
          class="settings-panel"
        >
          <div
            class="settings-section"
          >
            <div
              class="settings-section__header"
            >
              <div>
                <h2
                  class="settings-section__title"
                >
                  Collections
                </h2>
                <p
                  class="settings-section__description"
                >
                  Manage your collections. Each collection can have categories and items.
                </p>
              </div>
              <button
                class="settings-section__addButton"
              >
                + New Collection
              </button>
            </div>
            <div
              class="settings-collection-grid"
            >
              <div
                class="settings-collection-card"
              >
                <div
                  class="settings-collection-card__content"
                >
                  <h3
                    class="settings-collection-card__name"
                  >
                    Test Collection 1
                  </h3>
                  <p
                    class="settings-collection-card__description"
                  >
                    First collection description
                  </p>
                  <div
                    class="settings-collection-card__meta"
                  >
                    <span
                      class="settings-collection-card__visibility settings-collection-card__visibility--public"
                    >
                      🌐 Public
                    </span>
                  </div>
                </div>
                <div
                  class="settings-collection-card__actions"
                >
                  <button
                    class="settings-collection-card__button"
                  >
                    Categories
                  </button>
                  <button
                    class="settings-collection-card__button"
                  >
                    Templates
                  </button>
                  <button
                    class="settings-collection-card__button"
                  >
                    Edit
                  </button>
                  <button
                    class="settings-collection-card__button settings-collection-card__button--danger"
                  >
                    Delete
                  </button>
                </div>
              </div>
              <div
                class="settings-collection-card"
              >
                <div
                  class="settings-collection-card__content"
                >
                  <h3
                    class="settings-collection-card__name"
                  >
                    Test Collection 2
                  </h3>
                  <p
                    class="settings-collection-card__description"
                  >
                    Second collection description
                  </p>
                  <div
                    class="settings-collection-card__meta"
                  >
                    <span
                      class="settings-collection-card__visibility "
                    >
                      🔒 Private
                    </span>
                  </div>
                </div>
                <div
                  class="settings-collection-card__actions"
                >
                  <button
                    class="settings-collection-card__button"
                  >
                    Categories
                  </button>
                  <button
                    class="settings-collection-card__button"
                  >
                    Templates
                  </button>
                  <button
                    class="settings-collection-card__button"
                  >
                    Edit
                  </button>
                  <button
                    class="settings-collection-card__button settings-collection-card__button--danger"
                  >
                    Delete
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
    <footer
      data-testid="site-footer"
    >
      Site Footer
    </footer>
  </div>
</div>
`;

