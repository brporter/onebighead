exports[`SettingsView > snapshots > should match snapshot in collection edit mode 1`] = `
<div>
  <div
    class="app"
  >
    <header
      data-testid="site-header"
    >
      <span>
        Site Header
      </span>
      <a
        class="gallery-link"
        href="/collections"
      >
        Return to Collections
      </a>
      <button
        aria-label="Support"
        class="support-link support-link--icon"
        title="Support"
      >
        <span
          class="support-link__icon"
        >
          ?
        </span>
      </button>
      <button
        data-testid="user-button"
      >
        User Button
      </button>
    </header>
    <div
      class="app__layout"
    >
      <nav
        aria-label="Settings navigation"
        class="app__sidebar"
      >
        <div
          class="settings-nav"
        >
          <ul
            class="settings-nav__list"
          >
            <li>
              <button
                class="settings-nav__item "
              >
                <span
                  class="settings-nav__icon"
                >
                  📊
                </span>
                <span
                  class="settings-nav__label"
                >
                  Dashboard
                </span>
              </button>
            </li>
            <li>
              <button
                class="settings-nav__item settings-nav__item--active"
              >
                <span
                  class="settings-nav__icon"
                >
                  📚
                </span>
                <span
                  class="settings-nav__label"
                >
                  Collections
                </span>
              </button>
            </li>
            <li>
              <button
                class="settings-nav__item "
              >
                <span
                  class="settings-nav__icon"
                >
                  📋
                </span>
                <span
                  class="settings-nav__label"
                >
                  Item Templates
                </span>
              </button>
            </li>
            <li>
              <button
                class="settings-nav__item "
              >
                <span
                  class="settings-nav__icon"
                >
                  👥
                </span>
                <span
                  class="settings-nav__label"
                >
                  Team Members
                </span>
              </button>
            </li>
            <li>
              <button
                class="settings-nav__item "
              >
                <span
                  class="settings-nav__icon"
                >
                  📦
                </span>
                <span
                  class="settings-nav__label"
                >
                  Data Export
                </span>
              </button>
            </li>
            <li>
              <button
                class="settings-nav__item "
              >
                <span
                  class="settings-nav__icon"
                >
                  🏢
                </span>
                <span
                  class="settings-nav__label"
                >
                  My Workspaces
                </span>
              </button>
            </li>
            <li>
              <button
                class="settings-nav__item "
              >
                <span
                  class="settings-nav__icon"
                >
                  💬
                </span>
                <span
                  class="settings-nav__label"
                >
                  Support
                </span>
              </button>
            </li>
            <li>
              <button
                class="settings-nav__item "
              >
                <span
                  class="settings-nav__icon"
                >
                  👤
                </span>
                <span
                  class="settings-nav__label"
                >
                  Account
                </span>
              </button>
            </li>
          </ul>
        </div>
      </nav>
      <main
        class="app__content settings-content"
      >
        <div
          class="settings-title-bar"
        >
          <h1
            class="settings-title-bar__title"
          >
            Settings
          </h1>
        </div>
        <div
          class="settings-panel"
        >
          <div
            class="settings-section"
          >
            <div
              class="settings-section__header"
            >
              <div>
                <h2
                  class="settings-section__title"
                >
                  Collections
                </h2>
                <p
                  class="settings-section__description"
                >
                  Manage your collections. Each collection can have categories and items.
                </p>
              </div>
            </div>
            <form
              class="settings-form"
            >
              <h3
                class="settings-form__title"
              >
                Edit Collection
              </h3>
              <div
                class="settings-form__field"
              >
                <label
                  class="settings-form__label"
                >
                  Name 
                  <span
                    class="settings-form__required"
                  >
                    *
                  </span>
                </label>
                <input
                  class="settings-form__input"
                  placeholder="My Collection"
                  type="text"
                  value="Test Collection 1"
                />
              </div>
              <div
                class="settings-form__field"
              >
                <label
                  class="settings-form__label"
                >
                  Description
                </label>
                <textarea
                  class="settings-form__textarea"
                  placeholder="A brief description of this collection"
                  rows="3"
                >
                  First collection description
                </textarea>
              </div>
              <div
                class="settings-form__field"
              >
                <label
                  class="settings-form__label"
                >
                  Hero Image URL
                </label>
                <input
                  class="settings-form__input"
                  placeholder="https://example.com/image.jpg"
                  type="url"
                  value="https://example.com/hero1.jpg"
                />
              </div>
              <div
                class="settings-form__field"
              >
                <label
                  class="settings-form__label"
                >
                  Item Templates
                </label>
                <p
                  class="settings-form__hint"
                >
                  Configure which templates are available when creating items in this collection.
                </p>
                <button
                  class="settings-form__button settings-form__button--secondary"
                  type="button"
                >
                  Manage Templates
                </button>
              </div>
              <div
                class="settings-form__field"
              >
                <label
                  class="settings-form__label"
                >
                  Visibility
                </label>
                <p
                  class="settings-form__hint"
                >
                  This collection is currently visible in your public gallery.
                </p>
                <button
                  class="settings-form__button settings-form__button--danger"
                  type="button"
                >
                  Unpublish Collection
                </button>
              </div>
              <div
                class="settings-form__actions"
              >
                <button
                  class="settings-form__button settings-form__button--primary"
                  type="submit"
                >
                  Save Changes
                </button>
                <button
                  class="settings-form__button settings-form__button--secondary"
                  type="button"
                >
                  Cancel
                </button>
              </div>
            </form>
          </div>
        </div>
      </main>
    </div>
    <footer
      data-testid="site-footer"
    >
      Site Footer
    </footer>
  </div>
</div>
`;

