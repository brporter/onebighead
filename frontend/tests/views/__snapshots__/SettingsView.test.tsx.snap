        class="app__content settings-content"
      >
        <div
          class="settings-title-bar"
        >
          <h1
            class="settings-title-bar__title"
          >
            Settings
          </h1>
        </div>
        <div
          class="settings-panel"
        >
          <div
            class="settings-section"
          >
            <div
              class="settings-section__header"
            >
              <div>
                <h2
                  class="settings-section__title"
                >
                  Data Export
                </h2>
                <p
                  class="settings-section__description"
                >
                  Download all your collections, categories, and items as a ZIP file. This includes all metadata and can be used for backup purposes.
                </p>
              </div>
            </div>
            <div
              class="settings-export-card"
            >
              <div
                class="settings-export-card__icon"
              >
                📦
              </div>
              <div
                class="settings-export-card__content"
              >
                <h3
                  class="settings-export-card__title"
                >
                  Export All Data
                </h3>
                <p
                  class="settings-export-card__description"
                >
                  Creates a ZIP archive containing JSON files with all your collections, categories, items, and their properties.
                </p>
              </div>
              <button
                class="settings-export-card__button"
              >
                Download Export
              </button>
            </div>
          </div>
        </div>
      </main>
    </div>
    <footer
      data-testid="site-footer"
    >
      Site Footer
    </footer>
  </div>
</div>
`;

