// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CategoryView > snapshots > should match snapshot with category selected 1`] = `
<div>
  <div
    class="app__layout"
  >
    <nav
      aria-label="Category navigation"
      class="app__sidebar"
    >
      <aside
        class="categoryNav"
      >
        <div
          class="categoryNav__header"
        >
          <h2
            class="categoryNav__headerTitle"
          >
            Categories
          </h2>
          <div
            class="categoryNav__headerActions"
          >
            <button
              aria-label="Add category"
              class="categoryNav__addBtn"
              type="button"
            >
              +
            </button>
            <button
              aria-label="Collapse categories"
              class="categoryNav__collapseBtn"
              type="button"
            >
              «
            </button>
          </div>
        </div>
        <nav
          aria-label="Category breadcrumb"
          class="categoryNav__breadcrumb"
        >
          <button
            aria-label="Navigate to All"
            class="categoryNav__breadcrumb-link"
            type="button"
          >
            All
          </button>
          <span
            aria-hidden="true"
            class="categoryNav__breadcrumb-sep"
          >
            ›
          </span>
          <span
            class="categoryNav__breadcrumb-current"
          >
            Root Category
          </span>
        </nav>
        <div
          class="categoryNav__list"
        >
          <button
            aria-label="Go back"
            class="categoryNav__back"
            type="button"
          >
            ← Back
          </button>
          <div
            class="categoryNav__row categoryNav__row--active"
            role="button"
            tabindex="0"
          >
            <span
              aria-hidden="true"
              class="categoryNav__dot"
              style="background-color: rgb(199, 125, 74);"
            />
            <div
              class="categoryNav__rowContent"
            >
              <span
                class="categoryNav__name"
              >
                All 
                Root Category
              </span>
            </div>
          </div>
          <div
            class="categoryNav__row"
            role="button"
            tabindex="0"
          >
            <span
              aria-hidden="true"
              class="categoryNav__dot"
              style="background-color: rgb(199, 125, 74);"
            />
            <div
              class="categoryNav__rowContent"
            >
              <span
                class="categoryNav__name"
              >
                Child Category
              </span>
            </div>
            <button
              aria-label="Edit Child Category"
              class="categoryNav__edit"
              type="button"
            >
              ✎
            </button>
          </div>
        </div>
        <dialog
          class="modal-dialog"
        >
          <div
            class="modal"
          >
            <div
              class="modal__header"
            >
              <h2
                class="modal__title"
              >
                Add Category
              </h2>
              <button
                aria-label="Close"
                class="modal__close"
                type="button"
              >
                ×
              </button>
            </div>
            <form
              class="modal__body"
            >
              <div
                class="modal__field"
              >
                <label
                  class="modal__label"
                  for="category-name"
                >
                  Name 
                  <span
                    class="modal__required"
                  >
                    *
                  </span>
                </label>
                <input
                  class="modal__input"
                  id="category-name"
                  placeholder="Category name"
                  required=""
                  type="text"
                  value=""
                />
              </div>
              <div
                class="modal__field"
              >
                <label
                  class="modal__label"
                  for="category-description"
                >
                  Description
                </label>
                <textarea
                  class="modal__textarea"
                  id="category-description"
                  placeholder="Optional description"
                  rows="3"
                />
              </div>
              <div
                class="modal__field"
              >
                <label
                  class="modal__label"
                  for="category-parent"
                >
                  Parent Category
                </label>
                <select
                  class="modal__select"
                  id="category-parent"
                >
                  <option
                    value=""
                  >
                    None (root level)
                  </option>
                  <option
                    value="1"
                  >
                    Root Category
                  </option>
                  <option
                    value="2"
                  >
                    Child Category
                  </option>
                </select>
              </div>
              <div
                class="modal__field"
              >
                <div
                  class="visibility-toggle"
                >
                  <label
                    class="visibility-label"
                  >
                    Visibility
                  </label>
                  <div
                    class="visibility-options"
                  >
                    <button
                      class="visibility-option selected"
                      title="Inherit from parent (Public)"
                      type="button"
                    >
                      Inherit (
                      Public
                      )
                    </button>
                    <button
                      class="visibility-option "
                      title="Mark as public"
                      type="button"
                    >
                      Public
                    </button>
                    <button
                      class="visibility-option "
                      title="Mark as private"
                      type="button"
                    >
                      Private
                    </button>
                  </div>
                  <div
                    class="visibility-effective"
                  >
                    Effective: 
                    <span
                      class="public"
                    >
                      Public
                    </span>
                  </div>
                </div>
              </div>
              <div
                class="modal__field"
              >
                <label
                  class="modal__label"
                >
                  Recommended Templates
                </label>
                <p
                  class="categoryTemplateSelector__loading"
                >
                  Loading templates...
                </p>
              </div>
              <div
                class="modal__actions"
              >
                <button
                  class="detail__btn detail__btn--primary"
                  disabled=""
                  type="submit"
                >
                  Create
                </button>
                <button
                  class="detail__btn detail__btn--secondary"
                  type="button"
                >
                  Cancel
                </button>
              </div>
            </form>
          </div>
        </dialog>
      </aside>
    </nav>
    <main
      class="app__content"
    >
      <div
        class="collection-title-bar"
      >
        <a
          class="collection-title-bar__title-link"
          data-discover="true"
