        >
          <h1
            class="collection-title-bar__title"
          >
            Test Collection
          </h1>
        </a>
        <p
          class="collection-title-bar__subtitle"
        >
          Browse categories, then view items and details.
        </p>
      </div>
      <section
        class="app__items"
      >
        <nav
          class="mobileNav"
        >
          <button
            class="mobileNav__back"
            type="button"
          >
            ← 
            Categories
          </button>
        </nav>
        <div
          class="subcategoryDropdown"
        >
          <label
            class="subcategoryDropdown__label"
            for="subcategory-filter"
          >
            Filter by subcategory:
          </label>
          <select
            class="subcategoryDropdown__select"
            id="subcategory-filter"
          >
            <option
              value=""
            >
              All items
            </option>
            <option
              value="2"
            >
              Child Category
            </option>
          </select>
        </div>
        <aside
          class="list"
        >
          <div
            class="list__header"
          >
            <h2
              class="list__title"
            >
              Items
            </h2>
            <div
              class="list__headerRight"
            >
              <div
                aria-label="Item count"
                class="list__count"
              >
                2
                 total
              </div>
              <button
                class="list__addButton"
                type="button"
              >
                + Add Item
              </button>
            </div>
          </div>
          <div
            class="list__masonry"
          >
            <div
              aria-label="Select Test Item 1"
              class="item-card item-card--textonly"
              role="button"
              tabindex="0"
            >
              <div
                class="item-card__ribbon"
                style="background: linear-gradient(90deg, rgb(199, 125, 74), rgb(212, 165, 116));"
              />
              <div
                class="item-card__body"
              >
                <div
                  class="item-card__name"
                >
                  Test Item 1
                </div>
                <div
                  class="item-card__meta"
                >
                  Summary 1
                </div>
              </div>
            </div>
            <div
              aria-label="Select Test Item 2"
              class="item-card item-card--textonly"
              role="button"
              tabindex="0"
            >
              <div
                class="item-card__ribbon"
                style="background: linear-gradient(90deg, rgb(199, 125, 74), rgb(212, 165, 116));"
              />
              <div
                class="item-card__body"
              >
                <div
                  class="item-card__name"
                >
                  Test Item 2
                </div>
                <div
                  class="item-card__meta"
                >
                  Summary 2
                </div>
              </div>
            </div>
          </div>
          <div
            aria-label="Pagination"
            class="list__pager"
          >
            <button
              class="list__pagerButton"
              disabled=""
              type="button"
            >
              Previous
            </button>
            <div
              class="list__pagerStatus"
            >
              Page 
